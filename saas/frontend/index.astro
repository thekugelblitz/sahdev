---
const cloud = import.meta.env.SAHDEV_TARGET === 'cloud';
const workspace = cloud ? '/dashboard' : '/app/';
const model = cloud ? '/dashboard#brands' : '/app/#ai';
const cards = [
 ['01','Workspace','See your team’s activity and open the workspace you need.',workspace],
 ['02','AI workspace',cloud ? 'Choose a brand to test a model against its credit budget.' : 'Search published knowledge and manage your assistant.',model],
 ['03',cloud ? 'Installation guide' : 'Widget studio',cloud ? 'Connect your service desk to a brand.' : 'Choose an orb, set a welcome message and install chat on your website.',cloud ? '/installation' : '/app/#widget']
];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#000000"/><meta name="description" content="Sahdev Business brings service teams, customer conversations and AI operations into a managed workspace."/><title>Sahdev Business — Support operations</title><style is:inline>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#000;color:#faf8f4;font:16px/1.55 Inter,system-ui,sans-serif}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #ff9d66;outline-offset:5px}.wrap{max-width:1340px;margin:auto;padding:0 clamp(18px,5vw,76px)}header,footer{display:flex;align-items:center;justify-content:space-between;padding:24px 0;border-bottom:1px solid #333;gap:20px}.logo{display:flex;gap:11px;align-items:center;font-weight:750;font-size:23px;letter-spacing:-1.2px}.mark{background:repeating-linear-gradient(115deg,#ff5c00 0 6px,transparent 6px 10px);width:31px;height:30px;border-radius:50%}nav,.actions{display:flex;align-items:center;gap:24px;font-size:14px}.entry,.cta{padding:10px 17px;border-radius:8px;border:1px solid #444;font-weight:650}.cta{background:#ff5c00;color:#170800;border-color:#ff5c00}.hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:6%;padding:clamp(48px,8vw,115px) 0}.kicker,.serial,.card small{font:600 11px/1.5 ui-monospace,monospace;letter-spacing:.15em;text-transform:uppercase;color:#ff8845}h1{font-size:clamp(52px,7.3vw,108px);line-height:.97;letter-spacing:-.075em;margin:22px 0 26px}h1 em{font-style:normal;color:#ff5c00}.lead{font-size:clamp(16px,1.5vw,21px);color:#bdb9b6;max-width:520px}.actions{margin-top:30px}.art{position:relative;isolation:isolate;overflow:hidden;min-height:370px;aspect-ratio:1.16;border-radius:18px;background:radial-gradient(ellipse at 52% 49%,#461b09,#130a05 58%,#080808 82%);border:1px solid #372318;display:grid;place-items:center}.art:before{content:'';position:absolute;inset:0;background-image:radial-gradient(#ffb89238 .8px,transparent .8px);background-size:14px 14px}.sphere{width:71%;aspect-ratio:1;border-radius:50%;position:relative;transform:rotate(-26deg);background:repeating-radial-gradient(ellipse at 90% 18%,#1d0700 0 2px,#ff5c00 3px 6px,#ffa36b 7px,#170800 9px 12px);box-shadow:inset -18px -25px 35px #170700df,inset 9px 7px 24px #ff965866,0 12px 65px #ff5c0026}.serial{position:absolute;bottom:17px;left:18px;color:#e6ba9d;font-size:10px}.tools{border-top:1px solid #34302e;padding:32px 0 64px}.tools h2{font-size:clamp(27px,4vw,45px);letter-spacing:-.055em;margin:0 0 22px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{display:grid;grid-template-rows:auto auto 1fr auto;background:#101010;border:1px solid #292929;border-radius:12px;padding:24px;transition:border-color .2s}.card:hover{border-color:#ff5c00}.card h3{font-size:22px;letter-spacing:-.04em;margin:18px 0 0}.card p{font-size:14px;color:#b9b5b2}.card b{color:#ff7730}footer{border-bottom:0;border-top:1px solid #333;font-size:13px;padding:23px 0;color:#c1bab4}@media(max-width:750px){.hero{grid-template-columns:1fr;gap:32px}.art{min-height:220px;aspect-ratio:1.85}.sphere{width:49%}.grid{grid-template-columns:1fr}.actions,nav{gap:12px}nav .jump{display:none}.card{padding:18px}.card h3{margin-top:8px}.entry,.cta{padding:11px}.kicker{font-size:10px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style></head><body><div class="wrap"><header><a href="/" class="logo"><i class="mark"></i>Sahdev</a><nav><a class="jump" href="#workspace">Workspace</a><a href={cloud?'/pricing':'/pricing/'}>Pricing</a><a class="entry" href={workspace}>Sign in ↗</a></nav></header><main><section class="hero"><div><span class="kicker">Sahdev Business / Support operations</span><h1>Your support<br/>team in <em>sync.</em></h1><p class="lead">{cloud?'Manage your brands, test AI models and track what each request costs from one workspace.':'Bring customer conversations, support tickets and shared knowledge into one workspace.'}</p><div class="actions"><a class="cta" href={workspace}>Open workspace ↗</a><a href="#workspace">Explore tools ↓</a></div></div><div class="art" aria-hidden="true"><div class="sphere"></div><span class="serial">SAHDEV / SIGNAL 001</span></div></section><section class="tools" id="workspace"><h2>Workspace tools</h2><div class="grid">{cards.map(([id,title,body,href])=><a class="card" href={href}><small>{id}</small><h3>{title}</h3><p>{body}</p><b aria-hidden="true">↗</b></a>)}</div></section>{cloud && <section class="tools"><h2>Pilot access</h2><p id="pilot-status">Pilot availability and pricing</p><a class="entry" href="/pricing">See plans and credit packs ↗</a></section>}</main><footer><span>Sahdev Business</span><a href={workspace}>Workspace ↗</a></footer></div></body></html>
