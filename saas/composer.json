{
  "name": "hostingspell/sahdev-cloud",
  "description": "Sahdev multi-brand control plane and metered AI gateway",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*",
    "laravel/framework": "^13.0",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php vendor/bin/phpunit"
  },
  "config": {"sort-packages": true, "optimize-autoloader": true, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
