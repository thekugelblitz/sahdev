{
    auto_https off
}
:80 {
    root * /var/www/sahdev/public
    encode zstd gzip
    @business {
        path /app /app/* /portal /portal/* /widget-preview /widget-preview/* /widget.js /widget.css /orb.css /_astro/* /manifest.webmanifest /api/*
        not path /api/v1 /api/v1/*
    }
    handle @business {
        reverse_proxy business:8080
    }
    request_body {
        max_size 256KB
    }
    @private path /.env* /.git/* /storage/* /vendor/* /config/*
    respond @private 404
    php_fastcgi sahdev-cloud-fpm:9000 {
        env HTTPS on
        env SERVER_PORT 443
        read_timeout 30s
    }
    file_server
}
